# ArachOS live/install medium package list
# Base userspace (the Arch `base` meta-package is intentionally omitted: it
# would pull a distribution kernel into an Arach-Kernel-only image.)
bash
coreutils
util-linux
procps-ng
grep
sed
gawk
findutils
diffutils
less
tar
gzip
bzip2
xz
zstd
file

# Boot
grub
efibootmgr
os-prober

# Filesystem
e2fsprogs
parted
xfsprogs
btrfs-progs
dosfstools
lvm2
mtools

# Network
networkmanager
openssh
curl
wget
wpa_supplicant

# Installer tooling (Calamares and Archiso dependencies)
calamares
hwinfo
squashfs-tools
libisoburn

# Explicit providers keep archiso builds noninteractive and reproducible.
iptables
jack2
noto-fonts
qt6-multimedia-ffmpeg
rust
tesseract-data-eng

# Graphical Environment (KDE Plasma Default)
plasma-meta

konsole
kio
kwayland
plasma-wayland-protocols
xorg-xwayland
xorg-server
# Video drivers (Hermes handles this for ArachOS, but we include base mesa)
mesa

# ArachOS system packages
rustd
rustd-resolved
rustd-compat-libs
rustd-cutover-tools
tuned-rs
libinput-rs
blerust
ccze-rs
hermes-gpu-stack
arach-hwd
corinth
arachos-release

# Arach Kernel (provides /boot/arach, /boot/rustd, /boot/rustd-resolved)
arach-kernel

# Utilities
fastfetch
chafa
dbus
polkit
kmod
sudo
man-db

# Extended Filesystem Support for Calamares "Everything" options
f2fs-tools
ntfs-3g
exfatprogs
jfsutils
nilfs-utils
mdadm
cryptsetup
device-mapper

# Extended Bootloader Options
refind
