FROM archlinux:latest

COPY archiso/keys/cachyos.gpg /usr/share/arachos/cachyos.gpg
COPY scripts/bootstrap-cachyos.sh /usr/local/sbin/bootstrap-cachyos
COPY scripts/mkarchiso-arach.patch /tmp/mkarchiso-arach.patch
COPY scripts/pacstrap-arach.patch /tmp/pacstrap-arach.patch

# Install build dependencies
RUN pacman -Syu --noconfirm base-devel git rust rust-src python gcc-fortran ripgrep pam dbus json-c \
    archiso sudo qemu-system-x86 qemu-desktop make meson ninja cmake libevdev mtdev \
    liburing openssl grub curl ca-certificates gnupg \
    && chmod 0755 /usr/local/sbin/bootstrap-cachyos \
    && /usr/local/sbin/bootstrap-cachyos \
    && patch --batch --forward --fuzz=0 /usr/bin/mkarchiso < /tmp/mkarchiso-arach.patch \
    && patch --batch --forward --fuzz=0 /usr/bin/pacstrap < /tmp/pacstrap-arach.patch \
    && rm -f /tmp/mkarchiso-arach.patch /tmp/pacstrap-arach.patch

# Create a build user
RUN useradd -m -G wheel -s /bin/bash builder && \
    echo "%wheel ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers

# Setup working directory
WORKDIR /home/builder/workspace
RUN chown -R builder:builder /home/builder

USER builder
RUN git config --global --add safe.directory "*"
ENV IN_CONTAINER=1
CMD ["bash", "ArachOS/scripts/podman-build-entrypoint.sh"]
