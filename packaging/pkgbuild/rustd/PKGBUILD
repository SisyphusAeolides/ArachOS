# Maintainer: Kenny Glauner <SisyphusAeolides@pm.me>
pkgbase=rustd
pkgname=('rustd' 'rustd-compat-libs' 'rustd-cutover-tools')
pkgver=0.1.2
pkgrel=17
pkgdesc="RustD native Linux init and service manager"
arch=('x86_64')
url="https://github.com/SisyphusAeolides/rustd"
license=('LGPL-2.1-or-later')
makedepends=('cargo' 'git' 'gcc' 'gcc-fortran' 'make' 'python' 'pam' 'dbus' 'json-c')
options=('!lto')

_commit=97f7744e4f100e5122f164ad35ba82339289ad48
source=("git+${url}.git#commit=${_commit}")
sha256sums=('SKIP')

build() {
  cd "$pkgbase"
  make build pam-module libs compat
}

package_rustd() {
  pkgdesc="RustD native Linux init and service manager"
  depends=('dbus' 'rustd-cutover-tools')
  provides=('systemd' 'systemd-sysvcompat')
  conflicts=('systemd' 'systemd-sysvcompat')

  cd "$pkgbase"
  make DESTDIR="$pkgdir" \
       PREFIX=/usr \
       LIBDIR=/usr/lib \
       PKGCONFIGDIR=/usr/lib/pkgconfig \
       PAMLIBDIR=/usr/lib/security \
       install

  # Also install devel files here for simplicity
  mkdir -p "$pkgdir/usr/lib/pkgconfig"
  cat <<PC > "$pkgdir/usr/lib/pkgconfig/libudev.pc"
Name: libudev
Description: Library to access udev device information (RustD compat)
Version: 255
Libs: -L/usr/lib -ludev
Cflags: -I/usr/include
PC
  cat <<PC > "$pkgdir/usr/lib/pkgconfig/libsystemd.pc"
Name: libsystemd
Description: systemd System and Service Manager Libraries (RustD compat)
Version: 255
Libs: -L/usr/lib -lsystemd
Cflags: -I/usr/include
PC
  install -Dm0644 LICENSE.LGPL-2.1 "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

package_rustd-compat-libs() {
  pkgdesc="Arch libsystemd/libudev compatibility libraries backed by RustD"
  depends=("rustd=${pkgver}")
  provides=('systemd-libs' 'libsystemd' 'libudev' 'libsystemd.so' 'libudev.so')
  conflicts=('systemd-libs')
  replaces=('systemd-libs')

  cd "$pkgbase"
  install -d "$pkgdir/usr/lib"
  install -m0755 build/libs/libsystemd.so.0 "$pkgdir/usr/lib/libsystemd.so.0"
  ln -s libsystemd.so.0 "$pkgdir/usr/lib/libsystemd.so"
  install -m0755 build/libs/libudev.so.1 "$pkgdir/usr/lib/libudev.so.1"
  ln -s libudev.so.1 "$pkgdir/usr/lib/libudev.so"
  mkdir -p "$pkgdir/usr/lib/pkgconfig"
  cat <<PC > "$pkgdir/usr/lib/pkgconfig/libudev.pc"
Name: libudev
Description: Library to access udev device information (RustD compat)
Version: 255
Libs: -L/usr/lib -ludev
Cflags: -I/usr/include
PC
  cat <<PC > "$pkgdir/usr/lib/pkgconfig/libsystemd.pc"
Name: libsystemd
Description: systemd System and Service Manager Libraries (RustD compat)
Version: 255
Libs: -L/usr/lib -lsystemd
Cflags: -I/usr/include
PC
  install -Dm0644 LICENSE.LGPL-2.1 "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

package_rustd-cutover-tools() {
  pkgdesc="Nonconflicting authentication cutover tools"
  depends=('python')

  cd "$pkgbase"
  # Just install the PAM module since authselect is not used on Arch,
  # but keeping the package name consistent with the rustd expectation.
  install -d "$pkgdir/usr/lib/security"
  if [ -f target/release/libpam_rustd.so ]; then
      install -m0755 target/release/libpam_rustd.so "$pkgdir/usr/lib/security/pam_rustd.so"
  elif [ -f build/libs/pam_rustd.so ]; then
      install -m0755 build/libs/pam_rustd.so "$pkgdir/usr/lib/security/pam_rustd.so"
  fi
  mkdir -p "$pkgdir/usr/lib/pkgconfig"
  cat <<PC > "$pkgdir/usr/lib/pkgconfig/libudev.pc"
Name: libudev
Description: Library to access udev device information (RustD compat)
Version: 255
Libs: -L/usr/lib -ludev
Cflags: -I/usr/include
PC
  cat <<PC > "$pkgdir/usr/lib/pkgconfig/libsystemd.pc"
Name: libsystemd
Description: systemd System and Service Manager Libraries (RustD compat)
Version: 255
Libs: -L/usr/lib -lsystemd
Cflags: -I/usr/include
PC
  install -Dm0644 LICENSE.LGPL-2.1 "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
