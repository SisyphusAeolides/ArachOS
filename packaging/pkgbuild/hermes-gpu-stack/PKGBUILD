# Maintainer: Kenny Glauner <SisyphusAeolides@pm.me>
pkgname=hermes-gpu-stack
pkgver=0.1.0
pkgrel=3
pkgdesc="Hardware-qualified multi-vendor GPU and GSP compatibility stack"
arch=('x86_64')
url="https://github.com/SisyphusAeolides/Hermes"
license=('MIT')
depends=('rustd' 'kmod')
makedepends=('cargo' 'git' 'gcc' 'gawk')

_commit=a6f305871b9ba4604e2fbe9768269d8d5f1c3c43
source=("git+${url}.git#commit=${_commit}"
        "hermes-gpu.service")
sha256sums=('SKIP' 'SKIP')

build() {
  cd "Hermes"
  CARGO_PROFILE_RELEASE_DEBUG=2 cargo build --release --locked
}

package() {
  cd "Hermes"
  
  # Binaries
  for bin in hermes-ctl nvidia-smi nvidia-modprobe nvidia-settings nvidia-debugdump nvidia-persistenced nvidia-cuda-mps-control; do
    if [ -f "target/release/$bin" ]; then
      install -Dm0755 "target/release/$bin" "$pkgdir/usr/bin/$bin"
    fi
  done
  
  # Service
  install -Dm0644 "$srcdir/hermes-gpu.service" "$pkgdir/usr/lib/rustd/system/hermes-gpu.service"
  
  # Libraries (mapping Rust names to expected NVIDIA ABI names)
  if [ -f "target/release/libnvidia_ml.so" ]; then
    install -Dm0755 target/release/libnvidia_ml.so "$pkgdir/usr/lib/libnvidia-ml.so.1"
  fi
  if [ -f "target/release/libhermes_cuda.so" ]; then
    install -Dm0755 target/release/libhermes_cuda.so "$pkgdir/usr/lib/libcuda.so.1"
  fi
  if [ -f "target/release/libhermes_mesa.so" ]; then
    install -Dm0755 target/release/libhermes_mesa.so "$pkgdir/usr/lib/libGLX_nvidia.so.0"
    install -Dm0755 target/release/libhermes_mesa.so "$pkgdir/usr/lib/libEGL_nvidia.so.0"
  fi
  
  if [ -f LICENSE ]; then
    install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  fi
}
