# Maintainer: Kenny Glauner <SisyphusAeolides@pm.me>
pkgname=ccze-rs
pkgver=0.5.4
pkgrel=1
pkgdesc="Streaming log colorizer with native analytics and bounded parsing"
arch=('x86_64')
url="https://github.com/SisyphusAeolides/ccze-rs"
license=('MIT')
provides=('ccze')
conflicts=('ccze')
replaces=('ccze')
makedepends=('cargo' 'git' 'gcc-fortran')

_commit=CCZE_RS_COMMIT
source=("git+${url}.git#commit=${_commit}")
sha256sums=('SKIP')

build() {
  cd "$pkgname"
  export CFLAGS="${CFLAGS/-flto=auto/}"
  export LDFLAGS="${LDFLAGS/-flto=auto/}"
  CARGO_PROFILE_RELEASE_DEBUG=2 cargo build --release --locked
}

check() {
  cd "$pkgname"
  export CFLAGS="${CFLAGS/-flto=auto/}"
  export LDFLAGS="${LDFLAGS/-flto=auto/}"
  cargo test --locked --all-targets
}

package() {
  cd "$pkgname"
  export CFLAGS="${CFLAGS/-flto=auto/}"
  export LDFLAGS="${LDFLAGS/-flto=auto/}"
  install -Dm0755 target/release/ccze-rs "$pkgdir/usr/bin/ccze-rs"
  if [ -f LICENSE ]; then install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"; fi
}
