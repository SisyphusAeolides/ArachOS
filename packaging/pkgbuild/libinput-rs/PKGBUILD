# Maintainer: Kenny Glauner <SisyphusAeolides@pm.me>
pkgname=libinput-rs
pkgver=0.3.15
pkgrel=1
pkgdesc="Rust libinput implementation for ArachOS"
arch=('x86_64')
url="https://github.com/SisyphusAeolides/libinput-rs"
license=('MIT' 'Unicode-3.0')
provides=('libinput')
conflicts=('libinput')
replaces=('libinput')
depends=('rustd-compat-libs')
makedepends=('cargo' 'git' 'gcc' 'gcc-fortran' 'make' 'meson' 'ninja' 'patch' 'libevdev' 'mtdev' 'liburing' 'python')

_commit=c261a02410f3577517d75084bf00eb895e4cec5c
source=("git+${url}.git#commit=${_commit}"
        "libinput-rs-elan-resume.service")
sha256sums=('SKIP' 'SKIP')

build() {
  cd "$pkgname"
  CARGO_PROFILE_RELEASE_DEBUG=2 cargo build --release --locked
}

package() {
  cd "$pkgname"
  for bin in libinput libinput-device-group libinput-fuzz-extract libinput-fuzz-to-zero libinput-rs-chwd; do
    install -Dm0755 "target/release/$bin" "$pkgdir/usr/bin/$bin"
  done
  install -Dm0644 "$srcdir/libinput-rs-elan-resume.service" \
    "$pkgdir/usr/lib/rustd/system/libinput-rs-elan-resume.service"
  if [ -f LICENSE ]; then install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"; fi
}
