#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
    printf '%s\n' \
        'usage: arach-kernel-install --root=PATH --verify [--kernel=PATH]' \
        '       arach-kernel-install --root=PATH --install [--kernel=PATH]' >&2
    exit 2
}

root=/
mode=
kernel=
rustd=
resolved=
while (($#)); do
    case "$1" in
        --root=*) root=${1#*=} ;;
        --verify) mode=verify ;;
        --install) mode=install ;;
        --kernel=*) kernel=${1#*=} ;;
        --rustd=*) rustd=${1#*=} ;;
        --resolved=*) resolved=${1#*=} ;;
        --help|-h) usage ;;
        *) usage ;;
    esac
    shift
done
[[ -n $mode ]] || usage
[[ $root == /* && -d $root ]] || { printf 'Arach Kernel: invalid root: %s\n' "$root" >&2; exit 1; }

root_path() {
    local path=$1
    case "$path" in
        /*)
            if [[ $root == / ]]; then
                printf '%s\n' "$path"
            elif [[ $path == "$root"/* ]]; then
                printf '%s\n' "$path"
            else
                printf '%s%s\n' "$root" "$path"
            fi
            ;;
        *) printf '%s/%s\n' "$root" "$path" ;;
    esac
}

kernel=$(root_path "${kernel:-/boot/arach}")
rustd=$(root_path "${rustd:-/boot/rustd}")
resolved=$(root_path "${resolved:-/boot/rustd-resolved}")
manifest=$(root_path /usr/share/arachos/arach-kernel/bundle-manifest.txt)

fail() { printf 'Arach Kernel install: %s\n' "$*" >&2; exit 1; }
for path in "$kernel" "$rustd" "$resolved" "$manifest"; do
    [[ -s $path ]] || fail "required boot artifact is missing or empty: $path"
done

grub_file=
for candidate in grub-file grub2-file; do
    if command -v "$candidate" >/dev/null 2>&1; then
        grub_file=$candidate
        break
    fi
done
[[ -n $grub_file ]] || fail 'grub-file or grub2-file is required'
"$grub_file" --is-x86-multiboot2 "$kernel" \
    || fail 'Arach Kernel is not a valid Multiboot2 image'

readelf -hW "$rustd" | grep -Fq 'Class:                             ELF64' \
    || fail 'RustD payload is not ELF64'
readelf -hW "$resolved" | grep -Fq 'Class:                             ELF64' \
    || fail 'RustD-resolved payload is not ELF64'
! readelf -lW "$rustd" | grep -Fq 'INTERP' \
    || fail 'RustD PID 1 payload must be loader-free'

manifest_value() {
    sed -n "s/^$1=//p" "$manifest" | head -n 1
}
sha256_file() { sha256sum "$1" | awk '{print $1}'; }
for artifact in arach rustd rustd-resolved; do
    path=$kernel
    [[ $artifact == rustd ]] && path=$rustd
    [[ $artifact == rustd-resolved ]] && path=$resolved
    expected=$(manifest_value "artifact.${artifact}.sha256")
    [[ $expected =~ ^[0-9a-f]{64}$ ]] || fail "manifest has no digest for $artifact"
    [[ $(sha256_file "$path") == "$expected" ]] \
        || fail "digest mismatch for $artifact"
done

if [[ $mode == install ]]; then
    # Installing into a mounted target must never silently land on a tmpfs,
    # overlay, or the installer runtime.  Findmnt is preferred, with a strict
    # statfs fallback for minimal rescue environments.
    if command -v findmnt >/dev/null 2>&1; then
        fs_type=$(findmnt -T "$root" -no FSTYPE 2>/dev/null || true)
        case "$fs_type" in
            ''|tmpfs|overlay|squashfs|ramfs) fail "root is not persistent: ${fs_type:-unknown}" ;;
        esac
    fi

    install -d -m 0755 "$(dirname "$(root_path /etc/grub.d/40_arachos)")"
    cat > "$(root_path /etc/grub.d/40_arachos)" <<'GRUB'
#!/bin/sh
cat <<'EOF'
menuentry 'ArachOS — Arach Kernel' --class arachos --class gnu-linux {
    multiboot2 /boot/arach arachos=1 init=/usr/lib/rustd/rustd
    module2 /boot/rustd rustd
    module2 /boot/rustd-resolved rustd-resolved
    boot
}
EOF
GRUB
    chmod 0755 "$(root_path /etc/grub.d/40_arachos)"
    if command -v grub2-mkconfig >/dev/null 2>&1; then
        grub2-mkconfig -o "$(root_path /boot/grub2/grub.cfg)" >/dev/null
    elif command -v grub-mkconfig >/dev/null 2>&1; then
        grub-mkconfig -o "$(root_path /boot/grub2/grub.cfg)" >/dev/null
    else
        fail 'grub2-mkconfig or grub-mkconfig is required for installation'
    fi
fi

grub_cfg=$(root_path /boot/grub2/grub.cfg)
[[ -s $grub_cfg ]] || fail 'BIOS GRUB configuration is missing'
grep -Fq 'ArachOS' "$grub_cfg" || fail 'BIOS GRUB has no ArachOS entry'
grep -Fq '/boot/arach' "$grub_cfg" || fail 'BIOS GRUB does not load Arach Kernel'
grep -Fq '/boot/rustd' "$grub_cfg" || fail 'BIOS GRUB does not load RustD'
grep -Fq '/boot/rustd-resolved' "$grub_cfg" \
    || fail 'BIOS GRUB does not load RustD-resolved'

efi_cfg=$(root_path /boot/efi/EFI/arachos/grub.cfg)
[[ -s $efi_cfg ]] || fail 'UEFI ArachOS GRUB configuration is missing'
grep -Fq 'ArachOS' "$efi_cfg" || fail 'UEFI GRUB has no ArachOS entry'
grep -Fq '/boot/arach' "$efi_cfg" || fail 'UEFI GRUB does not load Arach Kernel'
grep -Fq '/boot/rustd' "$efi_cfg" || fail 'UEFI GRUB does not load RustD'
grep -Fq '/boot/rustd-resolved' "$efi_cfg" \
    || fail 'UEFI GRUB does not load RustD-resolved'

printf 'Arach Kernel boot contract verified for %s\n' "$root"
